#:kivy 2.3.0
<RoleSelectScreen>:
    name: 'role_select'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(30)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 0.737, 0.854, 1, 1  # BCDAFF background
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "WELCOME TO DIVYANG ASSISTANCE"
            font_size: '24sp'
            font_name: "Atkinson"
            color: 0, 0, 0, 1
            size_hint_y: None
            height: dp(40)

        Label:
            text: "Sign-up As"
            font_size: '20sp'
            font_name: "Atkinson"
            color: 0, 0, 0, 0.9
            size_hint_y: None
            height: dp(30)

        BoxLayout:
            orientation: 'vertical'
            spacing: dp(16)
            size_hint_y: None
            height: dp(140)

            Button:
                text: "User"
                font_size: '18sp'
                font_name: "Atkinson"
                background_color: 0.384, 0.58, 0.816, 1  # 6294D0
                color: 1, 1, 1, 1
                size_hint: None, None
                size: dp(220), dp(50)
                pos_hint: {'center_x': 0.5}
                on_release: app.root.current = 'user_signup'

            Button:
                text: "Admin"
                font_size: '18sp'
                font_name: "Atkinson"
                background_color: 0.384, 0.58, 0.816, 1
                color: 1, 1, 1, 1
                size_hint: None, None
                size: dp(220), dp(50)
                pos_hint: {'center_x': 0.5}
                on_release: root.show_admin_info()
