#:kivy 2.3.0

<RequestDetailScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: 20
        spacing: 15

        BoxLayout:
            size_hint_y: None
            height: 50

            Button:
                text: "< Back"
                size_hint_x: None
                width: 100
                on_release: root.go_back()

            Label:
                text: "Request Details"
                font_size: 20

        BoxLayout:
            orientation: "vertical"
            padding: 15
            spacing: 8
            size_hint_y: None
            height: 180

            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

            Label:
                text: "User: " + root.user_name
                halign: "left"
                text_size: self.width, None

            Label:
                text: "Service: " + root.service_name
                halign: "left"
                text_size: self.width, None

            Label:
                text: "Phone: " + root.phone
                halign: "left"
                text_size: self.width, None

            Label:
                text: "Status: " + root.status
                halign: "left"
                text_size: self.width, None
                color: (0, 0.6, 0, 1) if root.status == "Completed" else (0.8, 0.5, 0, 1)

        BoxLayout:
            orientation: "vertical"
            padding: 15
            spacing: 8
            size_hint_y: None
            height: 120

            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

            Label:
                text: "Address:"
                halign: "left"
                text_size: self.width, None

            Label:
                text: root.address
                halign: "left"
                text_size: self.width, None

        BoxLayout:
            orientation: "vertical"
            padding: 15
            spacing: 8

            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [15]

            Label:
                text: "Description:"
                halign: "left"
                text_size: self.width, None

            Label:
                text: root.description
                halign: "left"
                text_size: self.width, None

        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 10

            Button:
                text: "Mark Completed"
                background_color: (0, 0.6, 0, 1)
                on_release: root.mark_completed()

            Button:
                text: "Cancel"
                background_color: (0.8, 0, 0, 1)
                on_release: root.cancel_service()