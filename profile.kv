#:kivy 2.3.0

<ProfileScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        canvas.before:
            Color:
                rgba: 0.7, 0.5, 0.85, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 🔙 Back Button
        Button:
            text: "<"
            size_hint: None, None
            size: dp(50), dp(45)
            pos_hint: {"x": 0.03, "top": 0.95}
            on_release: app.root.current = "map_home"
            
        # 🧾 Title
        Label:
            text: "Profile"
            font_size: "24sp"
            bold: True
            size_hint_y: None
            height: dp(50)

        # 📄 Profile Details
        Label:
            text: "Name: Divyang User"
        Label:
            text: "Phone: 9876543210"
        Label:
            text: "Accessibility: Wheelchair"
        Label:
            text: "Email: user@email.com"

        Widget:

        # 🚪 Logout Button
        Button:
            text: "Logout"
            size_hint_y: None
            height: dp(55)
            background_color: 0.6, 0.1, 0.1, 1
            on_release: app.root.current = "role_select"
